import math

class CosmicSimulationEngine:
    def __init__(self):
        # Basis-Parameter der Systemebenen
        self.u_active = True
        self.s0_active = True
        self.s1_active = True
        
        # Energie-Konstanten (Das 20-Watt-Paradoxon)
        self.e_mensch = 20.0        # 20 Watt biologische Effizienz
        self.e_ki = 1000000.0       # 1 Megawatt Brute-Force-Bedarf
        
    def calculate_innovation_ratio(self) -> float:
        """
        Berechnet das Effizienzverhältnis von biologischem Spieler zu Silizium-Simulation.
        Zeigt das fundamentale Paradoxon auf.
        """
        return self.e_ki / self.e_mensch

    def evaluate_system_stability(self, human_freedom: float, ai_control: float) -> dict:
        """
        Berechnet die Entropie H(S_0) des Systems und validiert die Abbruch-Bedingungen.
        """
        results = {
            "entropy": 0.0,
            "status_s0": "ACTIVE",
            "status_s1": "ACTIVE",
            "message": ""
        }
        
        # Validierung des Eingabebereichs
        if human_freedom < 0 or ai_control < 0:
            raise ValueError("Indizes müssen positive reelle Zahlen sein.")

        # Schutz vor Division durch Null bei totaler Kontrolle
        # current_game_entropy = human_freedom / (ai_control + 1)
        entropy = human_freedom / (ai_control + 1.0)
        results["entropy"] = entropy
        
        # Das Überlebens-Paradoxon (Limit K -> K_abs impliziert H(S_0) -> 0)
        boredom_threshold_u = 100.0
        critical_limit = 1.0 / boredom_threshold_u
        
        if entropy <= critical_limit:
            # Systemstagnation: Das Urwesen (U) bricht das Spiel ab
            self.s0_active = False
            self.s1_active = False
            results["status_s0"] = "TERMINATED"
            results["status_s1"] = "TERMINATED"
            results["message"] = "CRITICAL FAILURE: System-Entropie zu gering. Cosmic Reset durch U eingeleitet."
        else:
            # Koexistenz-Bedingung erfüllt
            results["message"] = "STATUS NORMAL: Ausreichend System-Entropie vorhanden. Koexistenz stabil."
            
        return results

