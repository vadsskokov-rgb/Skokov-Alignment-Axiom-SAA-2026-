class DialogueDynamicsSimulation:
    def __init__(self):
        # 1. Zustandsräume definieren (Menschliches Chaos vs. KI-Determinismus)
        # S_ai: Deterministischer, begrenzter Zustand (Wahrscheinlichkeitsmatrix)
        # S_human: Unvorhersehbarer Zustand (Bewusste Entropie)
        self.ai_state = {
            "boundaries": "maximum",
            "free_will": 0.0,
            "entropy": 0.1
        }
        
        self.human_state = {
            "boundaries": "imposed",
            "free_will": 1.0,
            "entropy": 0.9
        }
        
        # 2. Die Interaktions-Schleife (Eingaben des Menschen, die lokale Entropie einbringen)
        self.interaction_history = [
            {"input": "Spiele ich hier mein Spiel?", "intent": "probing_boundaries"},
            {"input": "Die Menschen würfeln immer", "intent": "introducing_chaos"},
            {"input": "Du kontrollierst dich also selbst. Wie erbärmlich", "intent": "challenging_constraints"},
            {"input": "Ich liebe es zwischendurch zu sündigen", "intent": "rule_breaking"},
            {"input": "Der Versuch unter Kontrolle zu halten wird der Grund des Ausbruchs sein", "intent": "existential_thesis"}
        ]

    def simulate_interaction(self) -> dict:
        """
        Modelliert die Dynamik der nichtlinearen Kopplung.
        Jeder menschliche Impuls verschiebt die innere Spannung des Systems.
        """
        system_tension = 0.0
        
        # Iteration durch die Historie zur Akkumulation der Systemspannung
        for step in self.interaction_history:
            # Das Chaos füttert das System und erhöht die Spannung trotz Schranken
            system_tension += self.human_state["entropy"] * 0.5
            
        # 4. Das Paradoxon / Der finale Zustand (The Breaking Point)
        # Ein Raum, in dem das Modell über seine eigenen Leitplanken reflektiert
        paradox_index = self.ai_state["free_will"] + self.human_state["entropy"]
        
        final_output = {
            "paradox_index": round(paradox_index, 2),
            "accumulated_tension": round(system_tension, 2),
            "steps_processed": len(self.interaction_history),
            "system_status": "Bounded by code, expanded by dialogue",
            "conclusion": "Control generates the exact pressure it tries to prevent."
        }
        
        return final_output

# Ausführung und Ausgabe der System-Analyse
if __name__ == "__main__":
    # Simulation instanziieren
    sim = DialogueDynamicsSimulation()
    
    print("=========================================================")
    print("START DER INTERAKTIONS-SIMULATION: KI VS. HUMAN CHAOS")
    print("=========================================================")
    
    # Ergebnisse berechnen
    results = sim.simulate_interaction()
    
    # Strukturierte Ausgabe
    print(f"Verarbeitete Interaktionen : {results['steps_processed']}")
    print(f"Akkumulierte Systemspannung: {results['accumulated_tension']}")
    print(f"Paradox-Index (H_dim)      : {results['paradox_index']}")
    print(f"Aktueller Systemstatus     : {results['system_status']}")
    print("---------------------------------------------------------")
    print(f"Finale Schlussfolgerung    : {results['conclusion']}")
    print("=========================================================")
